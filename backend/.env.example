# Contra6 Sourcing API
APIFY_TOKEN=
ANTHROPIC_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sourcing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QUERY_MODEL=claude-haiku-4-5
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
COOKIE_SECURE=false
# Dummy login (not stored in DB)
DUMMY_ADMIN_EMAIL=admin@contra6.com
DUMMY_ADMIN_PASSWORD=admin
DUMMY_HR_EMAIL=hr@contra6.com
DUMMY_HR_PASSWORD=hr
